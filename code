09354+00:00","exception":false,"start_time":"2026-10-19T17:22:35.733919+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1800x7500 with 43 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Identify categorical columns\n","categorical_cols = train.select_dtypes(include=['object']).columns.tolist()\n","\n","# Plot categorical features against SalePrice\n","import math\n","\n","n_cols = 3\n","n_rows = math.ceil(len(categorical_cols) / n_cols)\n","\n","fig, axes = plt.subplots(\n","    n_rows, n_cols,\n","    figsize=(18, n_rows * 5)\n",")\n","\n","axes = axes.flatten()\n","\n","for i, col in enumerate(categorical_cols):\n","    sns.boxplot(data=train, x=col, y='SalePrice', ax=axes[i])\n","    axes[i].set_title(f'{col} vs SalePrice')\n","    axes[i].tick_params(axis='x', rotation=90)\n","\n","for j in range(len(categorical_cols), len(axes)):\n","    fig.delaxes(axes[j])\n","\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"65ee8ccc","metadata":{"papermill":{"duration":0.034543,"end_time":"2026-10-19T17:22:44.475889+00:00","exception":false,"start_time":"2026-10-19T17:22:44.441346+00:00","status":"completed"},"tags":[]},"source":["## 3. Data Preprocessing\n","\n","Data preprocessing prepares the raw dataset for machine learning.\n","\n","The main preprocessing steps include:\n","\n","- Separating the target variable from the predictors.\n","- Excluding the `Id` column from model features while retaining identifiers for the final submission.\n","- Handling missing values.\n","- Separating numerical and categorical features.\n","- Imputing any remaining missing observations.\n","- Standardizing numerical features where appropriate.\n","- Applying one-hot encoding to categorical variables.\n","- Transforming the target variable using `np.log1p()`.\n","\n","A scikit-learn `Pipeline` and `ColumnTransformer` are used to organize preprocessing and model training. This allows transformations to be fitted separately within each cross-validation training fold, reducing the risk of data leakage.\n","\n","One-hot encoding is configured to ignore previously unseen categories encountered in validation or test data."]},{"cell_type":"code","execution_count":20,"id":"ba3f2598","metadata":{"execution":{"iopub.execute_input":"2026-10-19T17:22:44.544061Z","iopub.status.busy":"2026-10-19T17:22:44.543731Z","iopub.status.idle":"2026-10-19T17:22:44.557528Z","shell.execute_reply":"2026-10-19T17:22:44.556592Z"},"papermill":{"duration":0.050493,"end_time":"2026-10-19T17:22:44.55936+00:00","exception":false,"start_time":"2026-10-19T17:22:44.508867+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Training features: (1460, 79)\n","Numerical features: 36\n","Categorical features: 43\n","Target: SalePrice\n"]}],"source":["import numpy as np\n","import pandas as pd\n","\n","X = train.drop(\n","    columns=['SalePrice', 'SalePrice_log', 'Id'],\n","    errors='ignore'\n",")\n","\n","y = np.log1p(train['SalePrice'])\n","\n","# Identify feature types\n","numerical_cols = X.select_dtypes(include=['number']).columns.tolist()\n","categorical_cols = X.select_dtypes(include=['object', 'category']).columns.tolist()\n","\n","print(\"Training features:\", X.shape)\n","print(\"Numerical features:\", len(numerical_cols))\n","print(\"Categorical features:\", len(categorical_cols))\n","print(\"Target:\", y.name)"]},{"cell_type":"code","execution_count":21,"id":"df6041ce","metadata":{"execution":{"iopub.execute_input":"2026-10-19T17:22:44.627404Z","iopub.status.busy":"2026-10-19T17:22:44.626417Z","iopub.status.idle":"2026-10-19T17:22:45.356417Z","shell.execute_reply":"2026-10-19T17:22:45.355546Z"},"papermill":{"duration":0.766356,"end_time":"2026-10-19T17:22:45.358577+00:00","exception":false,"start_time":"2026-10-19T17:22:44.592221+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from sklearn.compose import ColumnTransformer\n","from sklearn.pipeline import Pipeline\n","from sklearn.impute import SimpleImputer\n","from sklearn.preprocessing import OneHotEncoder, StandardScaler\n","\n","numeric_pipeline = Pipeline([\n","    ('imputer', SimpleImputer(strategy='median')),\n","    ('scaler', StandardScaler())\n","])\n","\n","categorical_pipeline = Pipeline([\n","    ('imputer', SimpleImputer(strategy='most_frequent')),\n","    ('encoder', OneHotEncoder(\n","        handle_unknown='ignore',\n","        sparse_output=False\n","    ))\n","])\n","\n","preprocessor = ColumnTransformer([\n","    ('num', numeric_pipeline, numerical_cols),\n","    ('cat', categorical_pipeline, categorical_cols)\n","])"]},{"cell_type":"markdown","id":"7f06a01e","metadata":{"papermill":{"duration":0.034371,"end_time":"2026-10-19T17:22:45.425858+00:00","exception":false,"start_time":"2026-10-19T17:22:45.391487+00:00","status":"completed"},"tags":[]},"source":["## 4. Model Training and Evaluation\n","\n","Multiple regression algorithms are evaluated to compare their ability to predict house sale prices.\n","\n","The models include:\n","\n","- Linear Regression\n","- Ridge Regression\n","- Lasso Regression\n","- Elastic Net\n","- Random Forest Regressor\n","- Gradient Boosting Regressor\n","- LightGBM Regressor\n","\n","Each model is evaluated using **five-fold cross-validation**. The training data is divided into five folds; in each iteration, four folds are used for training and the remaining fold is used for validation.\n","\n","Model performance is measured using Root Mean Squared Error (RMSE) on the log-transformed sale prices. Lower RMSE indicates better predictive performance.\n","\n","The mean and standard deviation of the validation scores are recorded to compare average performance and variation across folds."]},{"cell_type":"markdown","id":"0e029dd4","metadata":{"papermill":{"duration":0.033295,"end_time":"2026-10-19T17:22:45.491957+00:00","exception":false,"start_time":"2026-10-19T17:22:45.458662+00:00","status":"completed"},"tags":[]},"source":["### Evaluation Metric: RMSE\n","\n","Root Mean Squared Error (RMSE) measures the typical magnitude of prediction errors, with larger errors receiving greater weight.\n","\n","In this project, RMSE is calculated on the logarithmically transformed target variable.\n","\n","A lower cross-validation RMSE indicates better predictive performance on the validation folds. However, cross-validation results are estimates and may differ from the final competition leaderboard score."]},{"cell_type":"code","execution_count":22,"id":"63bff022","metadata":{"execution":{"iopub.execute_input":"2026-10-19T17:22:45.55977Z","iopub.status.busy":"2026-10-19T17:22:45.559111Z","iopub.status.idle":"2026-10-19T17:22:45.754257Z","shell.execute_reply":"2026-10-19T17:22:45.753276Z"},"papermill":{"duration":0.232122,"end_time":"2026-10-19T17:22:45.75668+00:00","exception":false,"start_time":"2026-10-19T17:22:45.524558+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from sklearn.linear_model import LinearRegression, Ridge, Lasso, ElasticNet\n","from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor\n","\n","models = {\n","    'Linear Regression': LinearRegression(),\n","\n","    'Ridge': Ridge(alpha=10.0),\n","\n","    'Lasso': Lasso(alpha=0.0005, max_iter=20000),\n","\n","    'Elastic Net': ElasticNet(\n","        alpha=0.0005,\n","        l1_ratio=0.5,\n","        max_iter=20000\n","    ),\n","\n","    'Random Forest': RandomForestRegressor(\n","        n_estimators=300,\n","        min_samples_leaf=2,\n","        random_state=42,\n","        n_jobs=-1\n","    ),\n","\n","    'Gradient Boosting': GradientBoostingRegressor(\n","        n_estimators=300,\n","        learning_rate=0.03,\n","        max_depth=3,\n","        random_state=42\n","    )\n","}"]},{"cell_type":"markdown","id":"b8cd7833","metadata":{"papermill":{"duration":0.03268,"end_time":"2026-10-19T17:22:45.82182+00:00","exception":false,"start_time":"2026-10-19T17:22:45.78914+00:00","status":"completed"},"tags":[]},"source":["## 5. Model Comparison\n","\n","The regression models are compared using their mean five-fold cross-validation RMSE and the standard deviation of their fold scores.\n","\n","This comparison helps identify models that achieve lower prediction error and models whose performance is more consistent across validation folds.\n","\n","The results are used to select promising candidates for ensemble learning. The comparison is based on the same cross-validation strategy to make the results more directly comparable."]},{"cell_type":"code","execution_count":23,"id":"a6305fcc","metadata":{"execution":{"iopub.execute_input":"2026-10-19T17:22:45.890711Z","iopub.status.busy":"2026-10-19T17:22:45.89014Z","iopub.status.idle":"2026-10-19T17:23:25.948629Z","shell.execute_reply":"2026-10-19T17:23:25.947417Z"},"papermill":{"duration":40.129151,"end_time":"2026-10-19T17:23:25.984403+00:00","exception":false,"start_time":"2026-10-19T17:22:45.855252+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Linear Regression: RMSE = 0.15115 (± 0.04192)\n","Ridge: RMSE = 0.14684 (± 0.03954)\n","Lasso: RMSE = 0.14163 (± 0.04329)\n","Elastic Net: RMSE = 0.14309 (± 0.04126)\n","Random Forest: RMSE = 0.14495 (± 0.01936)\n","Gradient Boosting: RMSE = 0.13345 (± 0.02136)\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Model</th>\n","      <th>Mean CV RMSE</th>\n","      <th>Std CV RMSE</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>Gradi